Bootstrap: docker
From: python:3.13-slim

%files
    ./config.py /Full_track_evaluator/config.py
    ./data_loader.py /Full_track_evaluator/data_loader.py
    ./evaluator_content_handler.py /Full_track_evaluator/evaluator_content_handler.py 
    ./evaluator_metrics_calculator.py /Full_track_evaluator/evaluator_metrics_calculator.py
    ./evaluator_RestAPI.py /Full_track_evaluator/evaluator_RestAPI.py

%environment
    export APPTAINER_NO_MOUNT="home,tmp,proc,sys,dev"
    export LC_ALL=C
    export PATH="/opt/conda/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/conda/lib:$LD_LIBRARY_PATH"
    
%post
    # Install system packages and dependencies
    echo "Installing system dependencies..."
    apt-get update && \
    apt-get install -y --no-install-recommends python3-pip bzip2 ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    echo "Installing Python dependencies..."
    python -m pip install --upgrade pip
    python -m pip install --no-cache-dir numpy tqdm pandas msgpack scipy pyBigWig requests fastparquet
    
    # Set permissions to access all directories
    echo "Setting permissions for directories and script..."
    chmod -R 755 /Full_track_evaluator/

%runscript
    exec python3 /Full_track_evaluator/evaluator_RestAPI.py "$@"

%startscript
    exec python3 /Full_track_evaluator/evaluator_RestAPI.py "$@"

%labels
    Author "Ishika Luthra"
    game_schema_version "1.0"
    Description "DNase-seq Track Evaluator using GAME Framework"

%help
    Full Track Evaluator -- GAME Framework

    Benchmarks bp-resolution track predictions against measured DNase signal
    (ENCFF972GVB, K562) on the 13 genomic regions held out as TEST data by BOTH
    Enformer and Borzoi, so neither model has seen them during training. Regions
    range from ~9.7 kb to ~23 Mb; the variable length is intentional and exercises
    how a Predictor handles sequences longer or shorter than its native input size.

    Reports two metrics per prediction task: Pearson r and Jensen-Shannon distance.

    REQUIRED BIND MOUNTS
        -B /path/to/evaluator_data:/evaluator_data
            Must contain:
              enformer_borzoi_test_seqs.parquet   sequences + coordinates
              ENCFF972GVB.bigWig                  measured DNase signal
        -B /path/to/output:/output
            Where the raw predictions JSON and the summary CSV are written.

    USAGE
        apptainer run \
            -B /path/to/evaluator_data:/evaluator_data \
            -B /path/to/output:/output \
            track_evaluator.sif <predictor_ip> <predictor_port> /output

    OUTPUT
        <EVALUATOR_NAME>_predictions_from_<PREDICTOR_NAME>.json
        evaluation_summary_<EVALUATOR_NAME>.csv   (appended to across runs)

    NOTES
        The Predictor must return linear-scale predictions and a bin_size; the
        evaluation is skipped otherwise. A task that cannot be scored is written
        to the CSV with value=NaN rather than omitted.